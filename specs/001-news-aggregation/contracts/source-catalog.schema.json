{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anxious-news-bot.local/schemas/source-catalog-v1.json",
  "title": "News Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_type",
          "endpoint_url",
          "region",
          "language_code",
          "enabled",
          "polling_interval_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_type": {
            "enum": ["rss", "atom"]
          },
          "endpoint_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "country_code": {
            "type": ["string", "null"],
            "pattern": "^[A-Z]{2}$"
          },
          "language_code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "enabled": {
            "type": "boolean"
          },
          "quality_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "polling_interval_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800
          },
          "credential_ref": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
