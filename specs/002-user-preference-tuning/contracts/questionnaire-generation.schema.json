{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anxious-news-bot.local/schemas/questionnaire-generation-v1.json",
  "title": "Questionnaire Generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "questions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "dimension_key", "text", "options"],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "dimension_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ordinal", "label"],
              "properties": {
                "ordinal": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    }
  }
}
