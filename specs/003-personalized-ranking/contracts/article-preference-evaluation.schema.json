{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anxious-news-bot.local/schemas/article-preference-evaluation-v1.json",
  "title": "Article Preference Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "article_analysis_id",
    "profile_revision",
    "parameter_set_hash",
    "relevances"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "article_id": { "type": "string", "format": "uuid" },
    "article_analysis_id": { "type": "string", "format": "uuid" },
    "profile_revision": { "type": "integer", "minimum": 0 },
    "parameter_set_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relevances": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter_id", "relevance", "reason_code"],
        "properties": {
          "parameter_id": { "type": "string", "format": "uuid" },
          "relevance": {
            "type": "string",
            "pattern": "^(?:-1\\.0000|-0\\.(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})|0\\.0000|0\\.[0-9]{4}|1\\.0000)$"
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 80
          }
        }
      }
    }
  }
}
