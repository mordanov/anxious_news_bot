{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anxious-news-bot.local/schemas/explicit-preference-changes-v1.json",
  "title": "Explicit Preference Change Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "base_profile_revision",
    "changes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "base_profile_revision": { "type": "integer", "minimum": 0 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/create" },
          { "$ref": "#/$defs/adjust" },
          { "$ref": "#/$defs/refine" },
          { "$ref": "#/$defs/deactivate" },
          { "$ref": "#/$defs/reactivate" }
        ]
      }
    }
  },
  "$defs": {
    "weight": {
      "type": "string",
      "pattern": "^(?:-?(?:0\\.(?:0[1-9]|[1-9][0-9]))|0\\.00|-?1\\.00)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "parameter_id": {
      "type": "string",
      "format": "uuid"
    },
    "semantic_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "semantic_key",
        "name",
        "description",
        "evaluation_instructions",
        "target_weight",
        "reason"
      ],
      "properties": {
        "action": { "const": "create" },
        "semantic_key": { "$ref": "#/$defs/semantic_key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evaluation_instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "target_weight": { "$ref": "#/$defs/weight" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "adjust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "parameter_id", "target_weight", "reason"],
      "properties": {
        "action": { "const": "adjust" },
        "parameter_id": { "$ref": "#/$defs/parameter_id" },
        "target_weight": { "$ref": "#/$defs/weight" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "refine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "parameter_id", "reason"],
      "anyOf": [
        { "required": ["name"] },
        { "required": ["description"] },
        { "required": ["evaluation_instructions"] }
      ],
      "properties": {
        "action": { "const": "refine" },
        "parameter_id": { "$ref": "#/$defs/parameter_id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evaluation_instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "deactivate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "parameter_id", "reason"],
      "properties": {
        "action": { "const": "deactivate" },
        "parameter_id": { "$ref": "#/$defs/parameter_id" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "reactivate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "parameter_id", "reason"],
      "properties": {
        "action": { "const": "reactivate" },
        "parameter_id": { "$ref": "#/$defs/parameter_id" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    }
  }
}
